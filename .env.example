# JARVIS Server Configuration
# Copy this file to .env and fill in your values

# Required: Google AI API key for Gemini model
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Authentication token (default: dev-token)
JARVIS_TOKEN=dev-token

# Optional: Bind address (default: 127.0.0.1). Use 0.0.0.0 so a Quest
# headset on the LAN can reach the server; requires a secure JARVIS_TOKEN.
JARVIS_HOST=127.0.0.1

# Optional: Request timeout in seconds (default: 170)
JARVIS_ASK_TIMEOUT=170

# Optional: Use cached tests (default: 0 = run real tests)
JARVIS_CACHED_TESTS=0

# Optional: several Gemini API keys. When one runs out of quota or expires, JARVIS switches to the next.
# Keys are used in this order: GOOGLE_API_KEY, GOOGLE_API_KEY_1, GOOGLE_API_KEY_2, ... (any count).
# Free-tier quota is per Google Cloud PROJECT, so keys from the same project share one quota.
# GOOGLE_API_KEY_1=your-second-key
# GOOGLE_API_KEY_2=your-third-key
# JARVIS_KEY_STRATEGY=sticky        # sticky (default) or round_robin
# JARVIS_KEY_MAX_WAIT=20            # fail fast if every key is resting longer than this many seconds
# JARVIS_KEY_STATE_FILE=~/.config/jarvis/api_key_pool.json  # remembers the last used key across restarts
# JARVIS_KEY_BACKOFF_MAX=8      # consecutive quota failures on one key rest it up to this multiple of Google's suggested wait
# JARVIS_KEY_PROBE=1            # 0 disables the background quota prober for resting keys
# JARVIS_KEY_PROBE_LEAD=4       # probe a resting key this many seconds before its rest expires
# JARVIS_KEY_PROBE_TICK=2       # seconds between prober passes
