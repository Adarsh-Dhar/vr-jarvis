# JARVIS Server Configuration
# Copy this file to .env and fill in your values

# Required: Google AI API key for Gemini model
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Authentication token (default: dev-token)
JARVIS_TOKEN=dev-token

# Optional: Bind address (default: 127.0.0.1). Use 0.0.0.0 so a Quest
# headset on the LAN can reach the server; requires a secure JARVIS_TOKEN.
JARVIS_HOST=127.0.0.1

# Optional: Request timeout in seconds (default: 170)
JARVIS_ASK_TIMEOUT=170

# Optional: Use cached tests (default: 0 = run real tests)
JARVIS_CACHED_TESTS=0
